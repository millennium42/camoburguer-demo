DEMO_ADMIN_PASSWORD=
BUSINESS_TIME_ZONE=America/Sao_Paulo
# Somente para HTTP local em development/test; omitir em deploy HTTPS.
AUTH_COOKIE_SECURE=false
APP_ENV=development
DEMO_SEED_ENABLED=false
# Identidade resolvida exata e sem credenciais: endereco:porta/banco
DEMO_SEED_TARGET=

# ─── Delivery Much ──────────────────────────────────────
DELIVERYMUCH_ENABLED=false
