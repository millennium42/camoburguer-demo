{
  "name": "camoburguer-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/print-bridge",
    "apps/event-simulator",
    "packages/*"
  ],
  "scripts": {
    "check": "node scripts/check-syntax.mjs",
    "check:backend": "npm run check",
    "build": "npm run check",
    "lint": "biome ci .",
    "fix": "biome check --write .",
    "test": "npm run test:unit",
    "test:unit": "node --env-file-if-exists=.env.test --test-concurrency=1 --test tests/*.test.js",
    "test:cov": "node --env-file-if-exists=.env.test --test-concurrency=1 --experimental-test-coverage --test tests/*.test.js",
    "test:frontend": "node --test tests/ops-web.test.js",
    "test:db": "node --test tests/seed-demo-postgres.test.js",
    "test:migrations": "node --test --test-concurrency=1 tests/migrations.test.js tests/migrations-down.test.js tests/migrations-cli.test.js tests/postgres-fixture.test.js tests/retention-clock.test.js tests/retention-redaction.test.js",
    "test:timezone": "node --test --test-concurrency=1 tests/postgres-timezone.test.js tests/timezone-config.test.js tests/finance.test.js",
    "test:recovery": "node --test tests/backup-restore.test.js",
    "migrate:up": "node --env-file-if-exists=.env apps/api/src/migrate-cli.js up",
    "migrate:down": "node --env-file-if-exists=.env apps/api/src/migrate-cli.js down",
    "retention": "node --env-file-if-exists=.env apps/api/src/retention-cli.js",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "smoke": "node --env-file-if-exists=.env.test tests/smoke.mjs",
    "verify": "npm run lint && npm run test:cov && npm run build && npm run smoke",
    "start:api": "npm run start --workspace @camoburguer/api",
    "start:print": "npm run start --workspace @camoburguer/print-bridge",
    "start:sim": "npm run start --workspace @camoburguer/event-simulator",
    "graph:update": "bash scripts/graphify-update-wsl.sh",
    "graph:extract": "graphify extract . --out .",
    "graph:extract:code": "graphify extract . --out . --code-only",
    "seed:demo": "node scripts/seed-demo.mjs"
  },
  "dependencies": {
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@biomejs/biome": "^2.5.9",
    "@playwright/test": "^1.55.0",
    "@vitest/coverage-v8": "^4.1.11",
    "c8": "^12.0.0",
    "vitest": "^4.1.11"
  }
}
